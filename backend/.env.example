# Copy to backend/.env for local runs. Never commit the real file.

# "google" reads the real sheets, "demo" uses built-in sample data. Defaults to google when a key is present.
DATA_SOURCE=demo

# Google service account (read-only). Share each sheet with the account's client_email as Viewer.
# Either paste the whole JSON on one line, or point to a file outside the repo.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# How often sheet data is re-read (seconds). 60 = live per minute.
LIVE_TTL_SECONDS=60
TAB_TTL_SECONDS=600
REFRESH_COOLDOWN_SECONDS=15

# Optional sign-in. When set, the dashboard asks for this passcode. Use a long random TOKEN_SECRET in production.
DASHBOARD_PASSCODE=
TOKEN_SECRET=change-me
TOKEN_HOURS=336

# FLO Future page: id of the month's "FLO_Future <Mon YYYY>" sheet. Empty = the id in app/config.py. When a new
# month's copy is made, share it with the service account as Viewer and put its id here.
FLO_FUTURE_SHEET_ID=

# Vendor Rate page: id of the sheet with the "Rate_Data" / "NEW RATE SHEET" tabs. Empty = FABRIC PO 11 (app/config.py).
VENDOR_RATE_SHEET_ID=
# "IN/OUT/SALE 2026-27" sheet (In/Out Sale page); set to a new year's copy without a code change.
IN_OUT_SALE_SHEET_ID=
# "Sir_Daily_Delegation_Tracker" (Daily Delegation page reads only its "Daily Schedule" tab).
DAILY_DELEGATION_SHEET_ID=
# Stock Ageing page, live from EasyTrade through its read-only MCP server (yesterday's closing, pulled about once a
# day). The token is a secret: put it here and in Vercel's environment variables, never in git or a chat.
EASYTRADE_MCP_URL=
EASYTRADE_MCP_TOKEN=
# Where each day's pull is cached (default: the system temp folder).
EASYTRADE_CACHE_DIR=
# Or / as a fallback: a folder holding stock_ageing.json (an EasyTrade snapshot). Keep it OUTSIDE the repo.
# Neither set = made-up demo rows with a warning on the page.
SQL_SNAPSHOT_DIR=

# Extra origins allowed to call the API from a browser (comma separated). Not needed for the mobile app.
CORS_ORIGINS=

# FLO Assistant (chatbot). It answers from the dashboard's own numbers with rules, no AI needed.
# Optional: a Gemini key lets a small model help read questions the rules can't place. It only sees the question
# and the dashboard's labels, never any figures. Leave empty to run on rules alone.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
ASSISTANT_GEMINI=on
# The one step that sends figures to Gemini: rewriting a finished answer in the language of the question.
# "off" keeps the rules' own wording (Gemini still reads questions, with labels only).
ASSISTANT_GEMINI_PHRASING=on
