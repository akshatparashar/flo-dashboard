{
  "name": "FLO Operations",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "cd backend && python -m venv .venv && .venv/bin/pip install -r requirements-dev.txt && cd ../frontend && npm install",
  "postAttachCommand": {
    "api": "cd backend && .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "web": "cd frontend && npx vite --host 0.0.0.0 --port 5173"
  },
  "portsAttributes": {
    "5173": { "label": "Dashboard", "onAutoForward": "openPreview" },
    "8000": { "label": "API" }
  },
  "forwardPorts": [5173, 8000]
}
